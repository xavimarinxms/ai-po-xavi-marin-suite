# AI PO Xavi Marín Suite — environment variables
#
# The suite does not call any API itself: it is a navigation shell that
# loads each tool (a separate Next.js app) inside an iframe. Every variable
# below is the public URL where one tool is reachable.
#
# Because Next.js inlines NEXT_PUBLIC_* vars at build time, leaving one
# empty is safe — that tool will show a "not deployed yet" state instead
# of an empty iframe. You can deploy tools one at a time.
#
# LOCAL DEV
# Point each var at the port that tool's `npm run dev` uses, e.g.:
#   cd tools/user-stories-generator && npm run dev -- -p 3001
# Repeat for every tool on a different port.
#
# PRODUCTION
# Point each var at its subdomain once deployed, e.g. https://rice.xavimarin.net

NEXT_PUBLIC_TOOL_FEEDBACK_SYNTHESIZER=http://localhost:3001
NEXT_PUBLIC_TOOL_INTERVIEW_INSIGHTS=http://localhost:3002
NEXT_PUBLIC_TOOL_COMPETITOR_MONITOR=http://localhost:3003
NEXT_PUBLIC_TOOL_USER_STORIES=http://localhost:3004
NEXT_PUBLIC_TOOL_PRD_BUILDER=http://localhost:3005
NEXT_PUBLIC_TOOL_STORY_MAP=http://localhost:3006
NEXT_PUBLIC_TOOL_RICE_JIRA=http://localhost:3007
NEXT_PUBLIC_TOOL_STAKEHOLDER_UPDATES=http://localhost:3008
NEXT_PUBLIC_TOOL_RELEASE_NOTES=http://localhost:3009
NEXT_PUBLIC_TOOL_METRICS_DASHBOARD=http://localhost:3010
NEXT_PUBLIC_TOOL_OKR_GENERATOR=http://localhost:3011
NEXT_PUBLIC_TOOL_HYPOTHESIS_VALIDATOR=http://localhost:3012
NEXT_PUBLIC_TOOL_VALIDATION_CANVAS=http://localhost:3013
